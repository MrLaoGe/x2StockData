{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "synthetic",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "license"
        ],
        "properties": {
          "path": {
            "const": "examples/synthetic.json"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "const": "synthetic-CC0"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "synthetic": {
      "const": true
    }
  },
  "additionalProperties": false
}
